{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "apegate-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "apegate.io",
      "custom_domain": true
    },
    {
      "pattern": "www.apegate.io",
      "custom_domain": true
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://apegate.io",
    "NEXT_PUBLIC_PRIVY_APP_ID": "cmv1sxfv2009t0gk1a6hwqhdb",
    "PRIVY_APP_ID": "cmv1sxfv2009t0gk1a6hwqhdb"
  },
  "secrets": {
    "required": [
      "PRIVY_APP_SECRET",
      "HELIUS_API_KEY",
      "HELIUS_RPC_URL",
      "SOLANA_RPC_URL"
    ]
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
