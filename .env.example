# Public site identity
NEXT_PUBLIC_SITE_URL=https://apegate.io
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# Optional override. The keyless default is the public Pump launch stream.
# Never put a private API key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_PUMPPORTAL_WS_URL=wss://pumpportal.fun/api/data

# Official $APEGATE registry. Publish the confirmed mint first, then explicitly
# unlock the external buy route. The Gate trusts only the exact configured CA.
NEXT_PUBLIC_APEGATE_TOKEN_MINT=
OFFICIAL_TOKEN_LAUNCH_ENABLED=false
OFFICIAL_CREATOR_WALLET=
NEXT_PUBLIC_LAUNCH_BAY_ENABLED=false

# Recommended for dependable on-chain mint reads in production.
# A public Solana RPC is used as the rate-limited fallback.
HELIUS_RPC_URL=

# Optional. Risk checks use the service's keyless endpoint when this is absent.
RUGCHECK_API_KEY=

# Privy Vault scaffold. Copy the same Privy dashboard App ID into both ID
# fields. The public ID may enter the browser bundle; the other two values must
# remain server-side. The authorization key is base64 PKCS8 without PEM headers.
# Vault creation remains disabled even when every value is present.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_PRIVATE_KEY=

# Future Phase 1 production ingestion and storage (not consumed by this slice).
HELIUS_API_KEY=
PUMPPORTAL_API_KEY=
JUPITER_API_KEY=
DATABASE_URL=

# Optional explain-only Rafiki path through Cloudflare AI Gateway's
# /compat/chat/completions endpoint. Without all three, receipt explanations
# use the deterministic local fallback. A provider key is only needed when the
# selected Gateway model is not backed by a stored credential.
AI_GATEWAY_URL=
AI_GATEWAY_TOKEN=
RAFIKI_MODEL=
RAFIKI_PROVIDER_API_KEY=

# Launch Bay production metadata and execution destinations (not consumed
# while create_v2 building remains locked).
PINATA_JWT=
TREASURY_ADDRESS=
